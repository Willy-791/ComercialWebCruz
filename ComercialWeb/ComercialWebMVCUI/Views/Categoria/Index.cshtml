@model IEnumerable<ComercialWebEN.CategoriaEN>

@{
    ViewData["Title"] = "Categorías";
}

<!-- FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="container-custom">

    <!-- HEADER -->
    <div class="header">
        <h4><b><i class="fa-solid fa-layer-group"></i> Categorías</b></h4>

        <form asp-action="Index">
            <div class="search-box">
                <input type="text" name="Nombre" placeholder="Buscar categoría..." />
                <button type="submit" class="btn-search-icon">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- CARDS -->
    <div class="cards">
        <div class="card-box">
            <div class="card-title">TOTAL CATEGORIA</div>
            <div class="card-value">@Model.Count()</div>
        </div>
    </div>

    <!-- TABLA -->
    <div class="table-box">

        <div class="d-flex justify-content-between mb-3">
            <h6><b>Lista de Categorías</b></h6>
            <a asp-action="Create" class="btn btn-new">
                <i class="fa fa-plus"></i> Agregar
            </a>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>

                        <td class="acciones">
                            <a asp-action="Edit" asp-route-IdCategoria="@item.IdCategoria">
                                <i class="fa fa-pen"></i>
                            </a>

                            <a asp-action="Details" asp-route-IdCategoria="@item.IdCategoria">
                                <i class="fa fa-eye"></i>
                            </a>

                            <a asp-action="Delete" asp-route-IdCategoria="@item.IdCategoria">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>