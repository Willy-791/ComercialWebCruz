@model ComercialWebEN.RolEN

@{
    ViewData["Title"] = "Eliminar Rol";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="delete-container">

    <h4 class="delete-title">
        <i class="fa fa-trash"></i> Eliminar Rol
    </h4>

    <div class="warning">
        ⚠ ¿Estás seguro de eliminar este rol?
    </div>

    <div class="detail-item">
        <b>Nombre:</b> @Model.Nombre
    </div>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="IdRol" />

        <button type="submit" class="btn btn-delete">
            <i class="fa fa-trash"></i> Eliminar
        </button>

        <a asp-action="Index" class="btn btn-cancel">
            <i class="fa fa-arrow-left"></i> Cancelar
        </a>
    </form>

</div>