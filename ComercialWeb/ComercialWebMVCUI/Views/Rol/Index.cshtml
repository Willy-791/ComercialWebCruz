@model IEnumerable<ComercialWebEN.RolEN>

@{
    ViewData["Title"] = "Index";
    int numPage = 1;
    int numRegistro = 0;
    int numregistrosPorPage = 10;
    int[] tops = { 10, 20, 50, 100, 500, 1000, 10000, -1 };
    int topActual = (int)ViewBag.Top;
}

<h1>Buscar Rol</h1>

<div class="row">
    <div class="col-md-12">
        <form asp-action="Index">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Nombre</label>
                        <input type="text" class="form-control" name="nombre" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Top</label>
                        <select name="top_aux" class="form-control">
                            @{
                                foreach (var item in tops)
                                {
                                    string strIttem = item != -1 ? item.ToString() : "Todos";
                                    if (item != topActual)
                                    {
                                        <option value="@item">@strIttem</option>
                                    }
                                    else
                                    {
                                        <option value="@item" selected>@strIttem</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <input type="submit" value="Buscar" class="btn btn-primary" />
                        <a asp-action="Create" class="btn btn-success">Crear</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                Acciones
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.ActionLink("Modificar", "Edit", new { IdRol = item.IdRol }, new { @class = "btn btn-success" })
                    @Html.ActionLink("Ver", "Details", new { IdRol = item.IdRol }, new { @class = "btn btn-info" })
                    @Html.ActionLink("Eliminar", "Delete", new { IdRol = item.IdRol }, new { @class = "btn btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>
