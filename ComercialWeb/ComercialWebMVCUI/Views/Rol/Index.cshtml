@model IEnumerable<ComercialWebEN.RolEN>

@{
    ViewData["Title"] = "Roles";

    int[] tops = { 10, 20, 50, 100, 500, 1000, 10000, -1 };
    int topActual = ViewBag.Top != null ? (int)ViewBag.Top : 10;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="container-custom">

    <!-- HEADER -->
    <div class="header">
        <h4><i class="fa fa-user-shield"></i> Roles</h4>

        <form asp-action="Index" method="get">
            <div class="search-box">
                <input type="text" name="nombre" placeholder="Buscar rol..."
                       value="@Context.Request.Query["nombre"]" />
                <button class="btn-search" type="submit">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- FILTRO TOP -->
    <form asp-action="Index" method="get">
        <div class="filters">

            <select name="top_aux">
                @foreach (var item in tops)
                {
                    string txt = item != -1 ? item.ToString() : "Todos";
                    <option value="@item"
                            selected="@(item == topActual)">
                        @txt
                    </option>
                }
            </select>

            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
    </form>

    <!-- TABLA -->
    <div class="table-box">

        <div class="d-flex justify-content-between mb-3">
            <h6><b>Lista de Roles</b></h6>

            <a asp-action="Create" class="btn btn-new">
                <i class="fa fa-plus"></i> Agregar
            </a>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>

                        <td class="acciones">
                            <a asp-action="Edit" asp-route-IdRol="@item.IdRol">
                                <i class="fa fa-pen"></i>
                            </a>

                            <a asp-action="Details" asp-route-IdRol="@item.IdRol">
                                <i class="fa fa-eye"></i>
                            </a>

                            <a asp-action="Delete" asp-route-IdRol="@item.IdRol">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>