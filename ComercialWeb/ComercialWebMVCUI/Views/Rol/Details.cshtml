@model ComercialWebEN.RolEN

@{
    ViewData["Title"] = "Detalle del Rol";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="detail-container">

    <h4 class="detail-title">
        <i class="fa fa-user-shield"></i> Detalle del Rol
    </h4>

    <div class="detail-item">
        <span class="label">ID</span>
        <span class="value">@Model.IdRol</span>
    </div>

    <div class="detail-item">
        <span class="label">Nombre</span>
        <span class="value">@Model.Nombre</span>
    </div>

    <!-- BOTONES -->
    <div class="btn-group">
        <a asp-action="Edit" asp-route-IdRol="@Model.IdRol" class="btn btn-edit">
            <i class="fa fa-pen"></i> Editar
        </a>

        <a asp-action="Index" class="btn btn-back">
            <i class="fa fa-arrow-left"></i> Volver
        </a>
    </div>

</div>