@model ComercialWebEN.RolEN

@{
    ViewData["Title"] = "Details";
}

<h4>Detalle del Rol</h4>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IdRol)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdRol)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
    </dl>
</div>

<div class="form-group">
    <a asp-action="Edit" asp-route-IdRol="@Model.IdRol" class="btn btn-primary">
        Editar
    </a>
    <a asp-action="Index" class="btn btn-dark">
        Regresar
    </a>
</div>