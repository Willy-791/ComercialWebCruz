@model ComercialWebEN.RegistroPrestamoEN

@{
    ViewData["Title"] = "Create";

    List<ComercialWebEN.ClienteEN> clientes = ViewBag.Clientes as List<ComercialWebEN.ClienteEN>;
    List<ComercialWebEN.ProductoEN> productos = ViewBag.Productos as List<ComercialWebEN.ProductoEN>;
    List<ComercialWebEN.EstadoPrestamoEN> estados = ViewBag.Estados as List<ComercialWebEN.EstadoPrestamoEN>;
}

<h1>Create</h1>

<h4>RegistroPrestamo</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label>Cliente</label>
                <select asp-for="IdCliente" class="form-control">
                    <option value="">Seleccionar</option>
                    @foreach (var item in clientes)
                    {
                        <option value="@item.IdCliente">@item.Nombre</option>
                    }
                </select>
                <span asp-validation-for="IdCliente" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Producto</label>
                <select asp-for="IdProducto" class="form-control">
                    <option value="">Seleccionar</option>
                    @foreach (var item in productos)
                    {
                        <option value="@item.IdProducto">@item.Nombre</option>
                    }
                </select>
                <span asp-validation-for="IdProducto" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Estado</label>
                <select asp-for="IdEstadoPrestamo" class="form-control">
                    <option value="">Seleccionar</option>
                    @foreach (var item in estados)
                    {
                        <option value="@item.IdEstadoPrestamo">@item.Nombre</option>
                    }
                </select>
                <span asp-validation-for="IdEstadoPrestamo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Cantidad"></label>
                <input asp-for="Cantidad" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FechaFin"></label>
                <input asp-for="FechaFin" type="date" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Detalle"></label>
                <input asp-for="Detalle" class="form-control" />
            </div>

            <span class="text-danger">@ViewBag.Error</span>

            <div class="form-group mt-2">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}