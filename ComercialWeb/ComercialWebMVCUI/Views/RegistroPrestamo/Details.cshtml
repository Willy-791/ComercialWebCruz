@model ComercialWebEN.RegistroPrestamoEN

@{
    ViewData["Title"] = "Detalle de Préstamo";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="detail-container">

    <h4 class="detail-title">
        <i class="fa fa-handshake"></i> Detalle de Préstamo
    </h4>

    <div class="detail-item">
        <span class="label">Cliente</span>
        <span class="value">@Model.Cliente?.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Producto</span>
        <span class="value">@Model.Producto?.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Cantidad</span>
        <span class="value">@Model.Cantidad</span>
    </div>

    <div class="detail-item">
        <span class="label">Estado</span>
        <span class="value">@Model.EstadoPrestamo?.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Fecha Inicio</span>
        <span class="value">@Model.FechaInicio</span>
    </div>

    <div class="detail-item">
        <span class="label">Fecha Fin</span>
        <span class="value">@Model.FechaFin</span>
    </div>

    <div class="detail-item">
        <span class="label">Detalle</span>
        <span class="value">@Model.Detalle</span>
    </div>

    <!-- BOTONES -->
    <div class="btn-group">
        <a asp-action="Edit" asp-route-id="@Model.IdRegistroPrestamo" class="btn btn-edit">
            <i class="fa fa-pen"></i> Editar
        </a>

        <a asp-action="Index" class="btn btn-back">
            <i class="fa fa-arrow-left"></i> Volver
        </a>
    </div>

</div>