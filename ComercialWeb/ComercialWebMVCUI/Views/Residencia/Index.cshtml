@model IEnumerable<ComercialWebEN.ResidenciaEN>

<h2>Lista de Residencias</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Residencia</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>
                    @(item.Estado ? "Activo" : "Inactivo")
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdResidencia">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.IdResidencia">Detalle</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdResidencia">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>