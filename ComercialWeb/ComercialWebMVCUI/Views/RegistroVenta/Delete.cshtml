@model ComercialWebEN.RegistroVentaEN

@{
    ViewData["Title"] = "Eliminar Venta";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="delete-container">

    <h4 class="delete-title">
        <i class="fa fa-trash"></i> Eliminar Venta
    </h4>

    <div class="warning">
        ⚠ ¿Estás seguro de eliminar esta venta?
    </div>

    <div class="detail-item">
        <span><b>Cliente</b></span>
        <span>@Model.Cliente?.Nombre</span>
    </div>

    <div class="detail-item">
        <span><b>Producto</b></span>
        <span>@Model.Producto?.Nombre</span>
    </div>

    <div class="detail-item">
        <span><b>Cantidad</b></span>
        <span>@Model.Cantidad</span>
    </div>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="IdRegistroVenta" />

        <button type="submit" class="btn btn-delete">
            <i class="fa fa-trash"></i> Eliminar
        </button>

        <a asp-action="Index" class="btn btn-back">
            <i class="fa fa-arrow-left"></i> Cancelar
        </a>
    </form>

</div>