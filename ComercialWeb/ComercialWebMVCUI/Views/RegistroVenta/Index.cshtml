@model IEnumerable<ComercialWebEN.RegistroVentaEN>

@{
    ViewData["Title"] = "Ventas";

    int[] tops = { 10, 20, 50, 100, 500, 1000, 10000, -1 };
    int topActual = ViewBag.Top != null ? (int)ViewBag.Top : 10;

    List<ComercialWebEN.ClienteEN> clientes =
        ViewBag.Clientes as List<ComercialWebEN.ClienteEN> ?? new List<ComercialWebEN.ClienteEN>();

    List<ComercialWebEN.ProductoEN> productos =
        ViewBag.Productos as List<ComercialWebEN.ProductoEN> ?? new List<ComercialWebEN.ProductoEN>();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="container-custom">

    <!-- HEADER -->
    <div class="header">
        <h4><b>Registro de Ventas</b></h4>

        <a asp-action="Create" class="btn btn-new">
            <i class="fa fa-plus"></i> Nueva Venta
        </a>
    </div>

    <!-- CARDS -->
    <div class="cards">
        <div class="card-box">
            <div class="card-title">TOTAL VENTAS</div>
            <div class="card-value">@((Model ?? new List<ComercialWebEN.RegistroVentaEN>()).Count())</div>
        </div>

        <div class="card-box">
            <div class="card-title">CLIENTES</div>
            <div class="card-value">@clientes.Count</div>
        </div>

        <div class="card-box">
            <div class="card-title">PRODUCTOS</div>
            <div class="card-value">@productos.Count</div>
        </div>
    </div>

    <!-- FILTROS -->
    <form asp-action="Index" method="get">
        <div class="filters">

            <select name="IdCliente">
                <option value="0">Cliente</option>
                @foreach (var item in clientes)
                {
                    <option value="@item.IdCliente">@item.Nombre</option>
                }
            </select>

            <select name="IdProducto">
                <option value="0">Producto</option>
                @foreach (var item in productos)
                {
                    <option value="@item.IdProducto">@item.Nombre</option>
                }
            </select>

            <select name="Top_Aux">
                @foreach (var item in tops)
                {
                    string txt = item != -1 ? item.ToString() : "Todos";
                    <option value="@item" selected="@(item == topActual)">
                        @txt
                    </option>
                }
            </select>

            <button type="submit" class="btn btn-primary">
                <i class="fa fa-search"></i> Buscar
            </button>
        </div>
    </form>

    <!-- TABLA -->
    <div class="table-box">

        <div class="d-flex justify-content-between mb-3">
            <h6><b>Lista de Ventas</b></h6>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model ?? new List<ComercialWebEN.RegistroVentaEN>())
                {
                    <tr>
                        <td>@item.Cliente?.Nombre</td>
                        <td>@item.Producto?.Nombre</td>
                        <td>@item.Cantidad</td>
                        <td>@item.FechaVenta</td>

                        <td class="acciones">
                            <a asp-action="Edit" asp-route-id="@item.IdRegistroVenta" title="Editar">
                                <i class="fa fa-pen"></i>
                            </a>

                            <a asp-action="Details" asp-route-id="@item.IdRegistroVenta" title="Ver">
                                <i class="fa fa-eye"></i>
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.IdRegistroVenta" title="Eliminar">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>