@model ComercialWebEN.ClienteEN

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="delete-container">

    <h4 class="title">
        <i class="fa fa-triangle-exclamation"></i> Desactivar Cliente
    </h4>

    <div class="warning">
        ⚠️ ¿Estás seguro que deseas desactivar este cliente?
    </div>

    <div class="detail-item">
        <span class="label">Rol</span>
        <span class="value">@Model.Rol?.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Residencia</span>
        <span class="value">@Model.Residencia?.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Nombre</span>
        <span class="value">@Model.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Apellido</span>
        <span class="value">@Model.Apellido</span>
    </div>

    <div class="detail-item">
        <span class="label">Celular</span>
        <span class="value">@Model.Celular</span>
    </div>

    <div class="detail-item">
        <span class="label">Estado</span>
        <span class="value">
            @if (Model.Estado)
            {
                <span class="estado activo">ACTIVO</span>
            }
            else
            {
                <span class="estado inactivo">INACTIVO</span>
            }
        </span>
    </div>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="IdCliente" />

        <div class="mt-4">
            <input type="submit" value="Desactivar"
                   class="btn btn-danger-custom btn-custom" />

            <a asp-action="Index"
                   class="btn btn-cancel btn-custom">
                Cancelar
            </a>
        </div>

    </form>

</div>
