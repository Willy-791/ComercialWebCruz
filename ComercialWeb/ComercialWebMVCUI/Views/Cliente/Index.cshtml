@model IEnumerable<ComercialWebEN.ClienteEN>

@{
    ViewData["Title"] = "Clientes";
    int[] tops = { 10, 20, 50, 100, 500, 1000, 10000, -1 };
    int topActual = (int)ViewBag.Top;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="container-custom">

    <!-- HEADER -->
    <div class="header">
        <h4><i class="fa-solid fa-users"></i> Clientes</h4>

        <form asp-action="Index" class="d-flex">

            <div class="search-box">
                <input type="text" name="Nombre" placeholder="Buscar cliente..." />
                <button type="submit" class="btn-search-icon">
                    <i class="fa fa-search"></i>
                </button>
            </div>

            <select name="Top_Aux" class="top-select">
                @foreach (var item in tops)
                {
                    string txt = item != -1 ? item.ToString() : "Todos";

                    if (item == topActual)
                    {
                        <option value="@item" selected>@txt</option>
                    }
                    else
                    {
                        <option value="@item">@txt</option>
                    }
                }
            </select>

        </form>
    </div>

    <!-- CARD -->
    <div class="card-box">
        <div class="card-title">TOTAL CLIENTES</div>
        <div class="card-value">@Model.Count()</div>
    </div>

    <!-- TABLA -->
    <div class="table-box">

        <div class="d-flex justify-content-between mb-3">
            <h6><b>Lista de Clientes</b></h6>
            <a asp-action="Create" class="btn btn-new">
                <i class="fa fa-plus"></i> Agregar
            </a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Celular</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Apellido</td>
                        <td>@item.Celular</td>

                        <td>
                            <span id="estado-text-@item.IdCliente"
                                  class="estado @(item.Estado ? "activo" : "inactivo")">
                                @(item.Estado ? "Activo" : "Inactivo")
                            </span>

                            <label class="switch">
                                <input type="checkbox"
                                       @(item.Estado ? "checked" : "")
                                       onchange="cambiarEstado(@item.IdCliente, this)" />
                                <span class="slider"></span>
                            </label>
                        </td>

                        <td class="acciones">
                            <a asp-action="Edit" asp-route-IdCliente="@item.IdCliente">
                                <i class="fa fa-pen"></i>
                            </a>

                            <a asp-action="Details" asp-route-IdCliente="@item.IdCliente">
                                <i class="fa fa-eye"></i>
                            </a>

                            <a asp-action="Delete" asp-route-IdCliente="@item.IdCliente">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>

<script>
    function cambiarEstado(id, checkbox) {
        let estado = checkbox.checked;

        fetch('/Cliente/CambiarEstado', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                IdCliente: id,
                Estado: estado
            })
        })
        .then(res => res.json())
        .then(data => {

            if (!data.ok) return;

            let span = document.getElementById("estado-text-" + id);

            if (estado) {
                span.innerText = "Activo";
                span.className = "estado activo";
            } else {
                span.innerText = "Inactivo";
                span.className = "estado inactivo";
            }

        });
    }
</script>