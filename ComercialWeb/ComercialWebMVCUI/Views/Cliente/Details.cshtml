@model ComercialWebEN.ClienteEN

@{
    ViewData["Title"] = "Detalle Cliente";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="detail-container">

    <h4 class="title">
        <i class="fa fa-user"></i> Detalle del Cliente
    </h4>

    <div class="detail-item">
        <span class="label">Rol</span>
        <span class="value">@Model.Rol?.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Residencia</span>
        <span class="value">@Model.Residencia?.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Nombre</span>
        <span class="value">@Model.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Apellido</span>
        <span class="value">@Model.Apellido</span>
    </div>

    <div class="detail-item">
        <span class="label">Celular</span>
        <span class="value">@Model.Celular</span>
    </div>

    <div class="detail-item">
        <span class="label">Estado</span>
        <span class="value">
            @if (Model.Estado)
            {
                <span class="estado activo">ACTIVO</span>
            }
            else
            {
                <span class="estado inactivo">INACTIVO</span>
            }
        </span>
    </div>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-IdCliente="@Model.IdCliente"
               class="btn btn-edit btn-custom">
            <i class="fa fa-pen"></i> Editar
        </a>

        <a asp-action="Index" class="btn btn-back btn-custom">
            Regresar
        </a>
    </div>

</div>