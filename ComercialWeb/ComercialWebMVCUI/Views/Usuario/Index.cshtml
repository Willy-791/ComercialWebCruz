@model IEnumerable<ComercialWebEN.UsuarioEN>

@{
    ViewData["Title"] = "Usuarios";
    int[] tops = { 10, 20, 50, 100, 500, 1000, 10000, -1 };
    int topActual = (int)ViewBag.Top;
    List<ComercialWebEN.RolEN> roles = ViewBag.Roles as List<ComercialWebEN.RolEN>;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="container-custom">

    <!-- HEADER -->
    <div class="header">
        <h4><b><i class="fa-solid fa-users"></i> Usuarios</b></h4>

        <a asp-action="Create" class="btn btn-new">
            <i class="fa fa-plus"></i> Nuevo Usuario
        </a>
    </div>

    <!-- FILTROS -->
    <div class="table-box mb-3">
        <form asp-action="Index">
            <div class="row">

                <div class="col-md-3">
                    <input type="text" name="nombre" class="form-control" placeholder="Nombre" />
                </div>

                <div class="col-md-3">
                    <input type="text" name="apellido" class="form-control" placeholder="Apellido" />
                </div>

                <div class="col-md-3">
                    <input type="text" name="login" class="form-control" placeholder="Login" />
                </div>

                <div class="col-md-3">
                    <select name="idrol" class="form-control">
                        <option value="0">Rol</option>
                        @foreach (var item in roles)
                        {
                            <option value="@item.IdRol">@item.Nombre</option>
                        }
                    </select>
                </div>

            </div>

            <div class="row mt-2">

                <div class="col-md-3">
                    <select name="top_aux" class="form-control">
                        @foreach (var item in tops)
                        {
                            string strItem = item != -1 ? item.ToString() : "Todos";
                            if (item != topActual)
                            {
                                <option value="@item">@strItem</option>
                            }
                            else
                            {
                                <option selected value="@item">@strItem</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-9 text-end">
                    <button type="submit" class="btn btn-custom btn-save">
                        <i class="fa fa-search"></i> Buscar
                    </button>
                </div>

            </div>
        </form>
    </div>

    <!-- CARD -->
    <div class="cards">
        <div class="card-box">
            <div class="card-title">TOTAL USUARIOS</div>
            <div class="card-value">@Model.Count()</div>
        </div>
    </div>

    <!-- TABLA -->
    <div class="table-box">

        <h6><b>Lista de Usuarios</b></h6>

        <table class="table">
            <thead>
                <tr>
                    <th>Rol</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Login</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Rol.Nombre</td>
                        <td>@item.Nombre</td>
                        <td>@item.Apellido</td>
                        <td>@item.Login</td>
                        <td>@item.FechaRegistro</td>

                        <td class="acciones">
                            <a asp-action="Edit" asp-route-IdUsuario="@item.IdUsuario">
                                <i class="fa fa-pen"></i>
                            </a>

                            <a asp-action="Details" asp-route-IdUsuario="@item.IdUsuario">
                                <i class="fa fa-eye"></i>
                            </a>

                            <a asp-action="Delete" asp-route-IdUsuario="@item.IdUsuario">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>