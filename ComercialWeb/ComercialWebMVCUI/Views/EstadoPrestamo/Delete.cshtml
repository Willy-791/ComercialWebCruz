@model ComercialWebEN.EstadoPrestamoEN

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar Estado de Préstamo</h1>

<h5>¿Estás seguro que deseas eliminar este estado de préstamo?</h5>

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdEstadoPrestamo" />

    <div class="form-group">
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-dark">Cancelar</a>
    </div>
</form>