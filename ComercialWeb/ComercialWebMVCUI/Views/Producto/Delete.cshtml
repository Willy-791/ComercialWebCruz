@model ComercialWebEN.ProductoEN

@{
    ViewData["Title"] = "Eliminar Producto";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


<div class="delete-container">

    <h4 class="delete-title">
        <i class="fa fa-trash"></i> Eliminar Producto
    </h4>

    <div class="warning">
        ⚠ ¿Estás seguro de eliminar este producto?
    </div>

    <div class="detail-item">
        <span><b>Nombre</b></span>
        <span>@Model.Nombre</span>
    </div>

    <div class="detail-item">
        <span><b>Categoría</b></span>
        <span>@Model.Categoria?.Nombre</span>
    </div>

    <div class="detail-item">
        <span><b>Marca</b></span>
        <span>@Model.Marca?.Nombre</span>
    </div>

    <div class="detail-item">
        <span><b>Precio</b></span>
        <span>$@Model.Precio</span>
    </div>

    <div class="detail-item">
        <span><b>Stock</b></span>
        <span>@Model.Stock</span>
    </div>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="IdProducto" />

        <button type="submit" class="btn btn-delete">
            <i class="fa fa-trash"></i> Eliminar
        </button>

        <a asp-action="Index" class="btn btn-back">
            <i class="fa fa-arrow-left"></i> Cancelar
        </a>
    </form>

</div>