@model IEnumerable<ComercialWebEN.ProductoEN>

@{
    ViewData["Title"] = "Productos con Bajo Stock";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="container-custom">

    <!-- HEADER -->
    <div class="header">
        <h4><i class="fa fa-exclamation-triangle"></i> Productos con Bajo Stock</h4>

        <a asp-action="Index" class="btn btn-back">
            <i class="fa fa-arrow-left"></i> Volver
        </a>
    </div>

    <!-- CARD RESUMEN -->
    <div class="card-box">
        <div class="card-title">TOTAL PRODUCTOS CON STOCK BAJO</div>
        <div class="card-value">
            @Model.Count()
        </div>
    </div>

    <!-- TABLA -->
    <br/>
    <div class="table-box">
        <table class="table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Stock</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td class="stock-bajo">
                            <i class="fa fa-exclamation-circle"></i> @item.Stock
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>