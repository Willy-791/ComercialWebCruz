@model ComercialWebEN.ProductoEN

@{
    ViewData["Title"] = "Detalle Producto";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="detail-container">

    <h4 class="detail-title">
        <i class="fa fa-box"></i> Detalle del Producto
    </h4>

    <div class="detail-item">
        <span class="label">Categoría</span>
        <span class="value">@Model.Categoria?.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Marca</span>
        <span class="value">@Model.Marca?.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Nombre</span>
        <span class="value">@Model.Nombre</span>
    </div>

    <div class="detail-item">
        <span class="label">Descripción</span>
        <span class="value">@Model.Descripcion</span>
    </div>

    <div class="detail-item">
        <span class="label">Precio</span>
        <span class="value">$@Model.Precio</span>
    </div>

    <div class="detail-item">
        <span class="label">Stock</span>
        <span class="value @(Model.Stock < 10 ? "stock-bajo" : "")">
            @Model.Stock
        </span>
    </div>

    <!-- BOTONES -->
    <div class="btn-group">
        <a asp-action="Edit" asp-route-IdProducto="@Model.IdProducto" class="btn btn-edit">
            <i class="fa fa-pen"></i> Editar
        </a>

        <a asp-action="Index" class="btn btn-back">
            <i class="fa fa-arrow-left"></i> Volver
        </a>
    </div>

</div>