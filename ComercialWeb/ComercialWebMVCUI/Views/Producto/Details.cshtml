@model ComercialWebEN.ProductoEN

@{
    ViewData["Title"] = "Details";
   
}

<h1>Detalles de Producto </h1>

<div>
    <hr />
    <dl class="row">

        <dt class="col-sm-4">Categoría</dt>
        <dd class="col-sm-8">@Model.Categoria?.Nombre</dd>

        <dt class="col-sm-4">Marca</dt>
        <dd class="col-sm-8">@Model.Marca?.Nombre</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Nombre)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Nombre)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Descripcion)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Descripcion)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Precio)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Precio)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Stock)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Stock)</dd>

        

    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-IdProducto="@Model.IdProducto">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>