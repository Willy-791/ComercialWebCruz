@model ComercialWebEN.ProductoEN

@{
    ViewData["Title"] = "Actualizar Stock";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="form-container">

    <h4 class="form-title">
        <i class="fa fa-boxes"></i> Actualizar Stock
    </h4>

    <form asp-action="ActualizarStock">

        <input type="hidden" asp-for="IdProducto" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Producto -->
        <div class="form-group">
            <label>Producto</label>
            <input asp-for="Nombre" class="form-control" readonly />
        </div>

        <!-- Stock actual -->
        <div class="form-group">
            <label>Stock Actual</label>
            <input asp-for="Stock"
                   class="form-control stock-actual @(Model.Stock < 5 ? "stock-bajo" : "")"
                   readonly />
        </div>

        <!-- Cantidad -->
        <div class="form-group">
            <label>Cantidad (+ o -)</label>
            <input type="number" name="cantidad" class="form-control"
                   placeholder="Ej: 5 o -3" />
        </div>

        <!-- BOTONES -->
        <div class="text-center mt-3">
            <a asp-action="Index" class="btn btn-back">
                <i class="fa fa-arrow-left"></i> Cancelar
            </a>

            <button type="submit" class="btn btn-save">
                <i class="fa fa-save"></i> Actualizar
            </button>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}