@model ComercialWebEN.ProductoEN

@{
    ViewData["Title"] = "Create";
  
    List<ComercialWebEN.MarcaEN> marcas = ViewBag.Marca as List<ComercialWebEN.MarcaEN>;
    List<ComercialWebEN.CategoriaEN> categorias = ViewBag.Categoria as List<ComercialWebEN.CategoriaEN>;
}
<h1>Create</h1>

<h4>ProductoEN</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
                <div class="form-group">
                    <label asp-for="IdCategoria" class="control-label"></label>
                    <select asp-for="IdCategoria" class="form-control">
                        <option value="">Seleccionar</option>
                        @if (categorias != null)
                        {
                            foreach (var item in categorias)
                            {
                                <option value="@item.IdCategoria">@item.Nombre</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="IdCategoria" class="text-danger"></span>
                </div>
             
           
                <div class="form-group">
                    <label asp-for="IdMarca" class="control-label"></label>
                    <select asp-for="IdMarca" class="form-control">
                        <option value="">Seleccionar</option>
                        @if (marcas != null)
                        {
                            foreach (var item in marcas)
                            {
                                <option value="@item.IdMarca">@item.Nombre</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="IdMarca" class="text-danger"></span>
                </div>
                

            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Precio" class="control-label"></label>
                <input asp-for="Precio" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Stock" class="control-label"></label>
                <input asp-for="Stock" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

           

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}