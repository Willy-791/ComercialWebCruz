@model ComercialWebEN.ProductoEN

@{
    ViewData["Title"] = "Crear Producto";

    List<ComercialWebEN.MarcaEN> marcas = ViewBag.Marca as List<ComercialWebEN.MarcaEN>;
    List<ComercialWebEN.CategoriaEN> categorias = ViewBag.Categoria as List<ComercialWebEN.CategoriaEN>;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="form-container">

    <h4 class="form-title">
        <i class="fa fa-plus"></i> Crear Producto
    </h4>

    <form asp-action="Create">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Categoría -->
        <div class="form-group">
            <label>Categoría</label>
            <select asp-for="IdCategoria" class="form-control">
                <option value="">Seleccionar</option>
                @foreach (var item in categorias ?? new List<ComercialWebEN.CategoriaEN>())
                {
                    <option value="@item.IdCategoria">@item.Nombre</option>
                }
            </select>
            <span asp-validation-for="IdCategoria" class="text-danger"></span>
        </div>

        <!-- Marca -->
        <div class="form-group">
            <label>Marca</label>
            <select asp-for="IdMarca" class="form-control">
                <option value="">Seleccionar</option>
                @foreach (var item in marcas ?? new List<ComercialWebEN.MarcaEN>())
                {
                    <option value="@item.IdMarca">@item.Nombre</option>
                }
            </select>
            <span asp-validation-for="IdMarca" class="text-danger"></span>
        </div>

        <!-- Nombre -->
        <div class="form-group">
            <label>Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <!-- Descripción -->
        <div class="form-group">
            <label>Descripción</label>
            <input asp-for="Descripcion" class="form-control" />
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <!-- Precio -->
        <div class="form-group">
            <label>Precio</label>
            <input asp-for="Precio" class="form-control" />
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>

        <!-- Stock -->
        <div class="form-group">
            <label>Stock</label>
            <input asp-for="Stock" class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>

        <!-- BOTONES -->
        <div class="text-center mt-3">
            <a asp-action="Index" class="btn btn-back">
                <i class="fa fa-arrow-left"></i> Volver
            </a>

            <button type="submit" class="btn btn-save">
                <i class="fa fa-save"></i> Guardar
            </button>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}