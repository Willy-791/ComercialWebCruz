@model IEnumerable<ComercialWebEN.ProductoEN>

@{
    ViewData["Title"] = "Index";

    int[] tops = { 10, 20, 50, 100, 500, 1000, 10000, -1 };
    int topActual = ViewBag.Top != null ? (int)ViewBag.Top : 10;

    List<ComercialWebEN.MarcaEN> marcas =
        ViewBag.Marcas as List<ComercialWebEN.MarcaEN> ?? new List<ComercialWebEN.MarcaEN>();

    List<ComercialWebEN.CategoriaEN> categorias =
        ViewBag.Categorias as List<ComercialWebEN.CategoriaEN> ?? new List<ComercialWebEN.CategoriaEN>();
}

<h1>Buscar Producto</h1>

<div class="row">
    <div class="col-md-12">
        <form asp-action="Index" method="get">
            <div class="row">

                <div class="col-4">
                    <div class="form-group">
                        <label>Nombre</label>
                        <input type="text" class="form-control" name="Nombre" />
                    </div>
                </div>

                <div class="col-4">
                    <div class="form-group">
                        <label>Precio</label>
                        <input type="number" step="0.01" class="form-control" name="Precio" />
                    </div>
                </div>

                <div class="col-4">
                    <div class="form-group">
                        <label>Stock</label>
                        <input type="number" class="form-control" name="Stock" />
                    </div>
                </div>

            </div>

            <div class="row mt-2">

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Top</label>
                        <select name="Top_Aux" class="form-control">
                            @foreach (var item in tops)
                            {
                                string txt = item != -1 ? item.ToString() : "Todos";
                                <option value="@item" selected="@(item == topActual)">
                                    @txt
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Marca</label>
                        <select name="IdMarca" class="form-control">
                            <option value="0">Seleccionar Marca</option>
                            @foreach (var item in marcas)
                            {
                                <option value="@item.IdMarca">@item.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Categoría</label>
                        <select name="IdCategoria" class="form-control">
                            <option value="0">Seleccionar Categoría</option>
                            @foreach (var item in categorias)
                            {
                                <option value="@item.IdCategoria">@item.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

            </div>

            <div class="row mt-3">
                <div class="col-md-12">
                    <input type="submit" value="Buscar" class="btn btn-primary" />
                    <a asp-action="Create" class="btn btn-dark">Nuevo</a>
                    <a asp-action="BajoStock" class="btn btn-warning">Bajo Stock</a>
                </div>
            </div>
        </form>
    </div>
</div>

<hr />

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.IdProducto)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Precio)</th>
            <th>@Html.DisplayNameFor(model => model.IdMarca)</th>
            <th>@Html.DisplayNameFor(model => model.IdCategoria) </th>
            <th>@Html.DisplayNameFor(model => model.Stock)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model ?? new List<ComercialWebEN.ProductoEN>())
        {
            <tr>
                <td>@item.IdProducto</td>
                <td>@item.Nombre</td>
                <td>@item.Precio</td>
                <td>@Html.DisplayFor(modelItem => item.Marca.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Categoria.Nombre)</td>
                <td>@item.Stock</td>
                <td>
                    @Html.ActionLink("Modificar", "Edit", new { IdProducto = item.IdProducto }, new { @class = "btn btn-success" }) |
                    @Html.ActionLink("Ver", "Details", new { IdProducto = item.IdProducto }, new { @class = "btn btn-info" }) |
                    @Html.ActionLink("Eliminar", "Delete", new { IdProducto = item.IdProducto }, new { @class = "btn btn-danger" }) |

                    <a asp-action="ActualizarStock"
                           asp-route-idProducto="@item.IdProducto"
                           class="btn btn-warning">
                        Stock
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>