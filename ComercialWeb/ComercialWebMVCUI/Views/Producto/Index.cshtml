@model IEnumerable<ComercialWebEN.ProductoEN>

@{
    ViewData["Title"] = "Productos";

    List<ComercialWebEN.MarcaEN> marcas =
        ViewBag.Marcas as List<ComercialWebEN.MarcaEN> ?? new List<ComercialWebEN.MarcaEN>();

    List<ComercialWebEN.CategoriaEN> categorias =
        ViewBag.Categorias as List<ComercialWebEN.CategoriaEN> ?? new List<ComercialWebEN.CategoriaEN>();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="container-custom">

    <!-- HEADER -->
    <div class="header">
        <h4><b>Inventario de Productos</b></h4>

        <form asp-action="Index" method="get">
            <div class="search-box">
                <input type="text" name="Nombre" placeholder="Buscar producto..."
                       value="@Context.Request.Query["Nombre"]" />
                <button type="submit" class="btn-search-icon">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- CARDS -->
    <div class="cards">
        <div class="card-box">
            <div class="card-title">TOTAL PRODUCTOS</div>
            <div class="card-value">@Model.Count()</div>
        </div>

        <div class="card-box">
            <div class="card-title">STOCK BAJO</div>
            <div class="card-value">
                @Model.Count(x => x.Stock < 10)
            </div>
        </div>

        <div class="card-box">
            <div class="card-title">CATEGORÍAS</div>
            <div class="card-value">@categorias.Count</div>
        </div>
    </div>

    <!-- FILTROS -->
    <form asp-action="Index" method="get">
        <div class="filters">

            <select name="IdMarca">
                <option value="0">Marca</option>
                @foreach (var item in marcas)
                {
                    <option value="@item.IdMarca"
                        selected="@(Context.Request.Query["IdMarca"] == item.IdMarca.ToString())">
                        @item.Nombre
                    </option>
                }
            </select>

            <select name="IdCategoria">
                <option value="0">Categoría</option>
                @foreach (var item in categorias)
                {
                    <option value="@item.IdCategoria"
                        selected="@(Context.Request.Query["IdCategoria"] == item.IdCategoria.ToString())">
                        @item.Nombre
                    </option>
                }
            </select>

            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
    </form>

    <!-- TABLA -->
    <div class="table-box">

        <div class="d-flex justify-content-between mb-3">
            <h6><b>Lista de Productos</b></h6>

            <div>
                <a asp-action="Create" class="btn btn-new">
                    <i class="fa fa-plus"></i> Agregar
                </a>

                <a asp-action="BajoStock" class="btn btn-warning">
                    <i class="fa fa-exclamation-triangle"></i>
                </a>
            </div>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Marca</th>
                    <th>Stock</th>
                    <th>Precio</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Categoria?.Nombre</td>
                        <td>@item.Marca?.Nombre</td>

                        <td class="@(item.Stock < 10 ? "stock-bajo" : "")">
                            @item.Stock
                        </td>

                        <td>$@item.Precio.ToString("N2")</td>

                        <td class="acciones">
                            <a asp-action="Edit" asp-route-IdProducto="@item.IdProducto">
                                <i class="fa fa-pen"></i>
                            </a>

                            <a asp-action="Details" asp-route-IdProducto="@item.IdProducto">
                                <i class="fa fa-eye"></i>
                            </a>

                            <a asp-action="Delete" asp-route-IdProducto="@item.IdProducto">
                                <i class="fa fa-trash"></i>
                            </a>

                            <a asp-action="ActualizarStock" asp-route-idProducto="@item.IdProducto">
                                <i class="fa fa-boxes"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>