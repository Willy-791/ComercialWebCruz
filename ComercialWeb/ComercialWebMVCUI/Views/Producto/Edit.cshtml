@model ComercialWebEN.ProductoEN

@{
    ViewData["Title"] = "Editar Producto";

    List<ComercialWebEN.MarcaEN> marcas = ViewBag.Marca as List<ComercialWebEN.MarcaEN>;
    List<ComercialWebEN.CategoriaEN> categorias = ViewBag.Categoria as List<ComercialWebEN.CategoriaEN>;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="form-container">

    <h4 class="form-title">
        <i class="fa fa-pen"></i> Editar Producto
    </h4>

    <form asp-action="Edit">
        <input type="hidden" asp-for="IdProducto" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Categoría -->
        <div class="form-group">
            <label>Categoría</label>
            <select asp-for="IdCategoria" class="form-control">
                <option value="">Seleccionar</option>
                @foreach (var item in categorias ?? new List<ComercialWebEN.CategoriaEN>())
                {
                    <option value="@item.IdCategoria"
                            selected="@(item.IdCategoria == Model.IdCategoria)">
                        @item.Nombre
                    </option>
                }
            </select>
        </div>

        <!-- Marca -->
        <div class="form-group">
            <label>Marca</label>
            <select asp-for="IdMarca" class="form-control">
                <option value="">Seleccionar</option>
                @foreach (var item in marcas ?? new List<ComercialWebEN.MarcaEN>())
                {
                    <option value="@item.IdMarca"
                            selected="@(item.IdMarca == Model.IdMarca)">
                        @item.Nombre
                    </option>
                }
            </select>
        </div>

        <!-- Nombre -->
        <div class="form-group">
            <label>Nombre</label>
            <input asp-for="Nombre" class="form-control" />
        </div>

        <!-- Descripción -->
        <div class="form-group">
            <label>Descripción</label>
            <input asp-for="Descripcion" class="form-control" />
        </div>

        <!-- Precio -->
        <div class="form-group">
            <label>Precio</label>
            <input asp-for="Precio" class="form-control" />
        </div>

        <!-- Stock -->
        <div class="form-group">
            <label>Stock</label>
            <input asp-for="Stock" class="form-control" />
        </div>

        <!-- BOTONES -->
        <div class="d-flex justify-content-between mt-3">
            <a asp-action="Index" class="btn btn-back">
             Volver
            </a>

            <button type="submit" class="btn btn-save">
             Guardar
            </button>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}