@model ComercialWebEN.ProductoEN

@{
    ViewData["Title"] = "Edit";
    
    List<ComercialWebEN.MarcaEN> marcas = ViewBag.Marca as List<ComercialWebEN.MarcaEN>;
    List<ComercialWebEN.CategoriaEN> categorias = ViewBag.Categoria as List<ComercialWebEN.CategoriaEN>;
}


<h1>Edit</h1>

<h4>ProductoEN</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="IdProducto" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="IdCategoria"></label>
                <select asp-for="IdCategoria" class="form-control">
                    <option value="">Seleccionar</option>
                    @if (categorias != null)
                    {
                        foreach (var item in categorias)
                        {
                            <option value="@item.IdCategoria">@item.Nombre</option>
                        }
                    }
                </select>
                <span asp-validation-for="IdCategoria" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IdMarca"></label>
                <select asp-for="IdMarca" class="form-control">
                    <option value="">Seleccionar</option>
                    @if (marcas != null)
                    {
                        foreach (var item in marcas)
                        {
                            <option value="@item.IdMarca">@item.Nombre</option>
                        }
                    }
                </select>
                <span asp-validation-for="IdMarca" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Nombre"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descripcion"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Precio"></label>
                <input asp-for="Precio" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Stock"></label>
                <input asp-for="Stock" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input class="form-check-input" asp-for="Estado" />
                <label class="form-check-label" asp-for="Estado"></label>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}